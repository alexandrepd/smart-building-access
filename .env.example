# Copy this file to .env and replace every placeholder before starting Compose.
POSTGRES_DB=smart_building
POSTGRES_USER=smart_building
POSTGRES_PASSWORD=replace-with-a-local-database-password

# Generate a value with: openssl rand -base64 48
AUTHENTICATION_SIGNING_KEY=replace-with-a-random-key-of-at-least-32-bytes

BOOTSTRAP_ADMIN_EMAIL=admin@example.invalid
BOOTSTRAP_ADMIN_PASSWORD=replace-with-an-initial-admin-password-of-at-least-12-characters

# Host port for the Angular application. Change it when port 8080 is already occupied.
WEB_PORT=8080
