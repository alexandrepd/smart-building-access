@SmartBuilding.Api_HostAddress = http://localhost:5077

GET {{SmartBuilding.Api_HostAddress}}/
Accept: application/json

###

# @name login
# Replace these values with the credentials used to bootstrap the first Admin.
POST {{SmartBuilding.Api_HostAddress}}/api/auth/login
Content-Type: application/json

{
	"email": "admin@example.invalid",
	"password": "replace-with-bootstrap-password"
}

###

@accessToken = {{login.response.body.accessToken}}

# Every request below this point uses the bearer token from the login response.
GET {{SmartBuilding.Api_HostAddress}}/api/buildings
Authorization: Bearer {{accessToken}}
Accept: application/json

###

GET {{SmartBuilding.Api_HostAddress}}/api/buildings/10000000-0000-0000-0000-000000000001
Authorization: Bearer {{accessToken}}
Accept: application/json

###

POST {{SmartBuilding.Api_HostAddress}}/api/buildings
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
	"name": "North Office",
	"address": "Porto"
}

###

PUT {{SmartBuilding.Api_HostAddress}}/api/buildings/10000000-0000-0000-0000-000000000001
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
	"name": "HQ Lisbon",
	"address": "Lisbon",
	"isActive": true
}

###

# Returns 409 because the seeded building contains a floor.
DELETE {{SmartBuilding.Api_HostAddress}}/api/buildings/10000000-0000-0000-0000-000000000001
Authorization: Bearer {{accessToken}}

###

# Returns 404 for an unknown building.
GET {{SmartBuilding.Api_HostAddress}}/api/buildings/00000000-0000-0000-0000-000000000099
Authorization: Bearer {{accessToken}}
Accept: application/json

###

# Returns 400 validation problem details.
POST {{SmartBuilding.Api_HostAddress}}/api/buildings
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
	"name": "",
	"address": ""
}

###

GET {{SmartBuilding.Api_HostAddress}}/api/floors
Authorization: Bearer {{accessToken}}
Accept: application/json

###

GET {{SmartBuilding.Api_HostAddress}}/api/floors/20000000-0000-0000-0000-000000000001
Authorization: Bearer {{accessToken}}
Accept: application/json

###

POST {{SmartBuilding.Api_HostAddress}}/api/floors
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
	"buildingId": "10000000-0000-0000-0000-000000000001",
	"number": 1,
	"name": "First Floor"
}

###

PUT {{SmartBuilding.Api_HostAddress}}/api/floors/20000000-0000-0000-0000-000000000001
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
	"buildingId": "10000000-0000-0000-0000-000000000001",
	"number": 0,
	"name": "Ground Floor",
	"isActive": true
}

###

# Returns 409 because the seeded floor contains an access point.
DELETE {{SmartBuilding.Api_HostAddress}}/api/floors/20000000-0000-0000-0000-000000000001
Authorization: Bearer {{accessToken}}

###

# Returns 404 because the parent building does not exist.
POST {{SmartBuilding.Api_HostAddress}}/api/floors
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
	"buildingId": "00000000-0000-0000-0000-000000000099",
	"number": 99,
	"name": "Unknown Building Floor"
}

###

GET {{SmartBuilding.Api_HostAddress}}/api/access-points
Authorization: Bearer {{accessToken}}
Accept: application/json

###

GET {{SmartBuilding.Api_HostAddress}}/api/access-points/30000000-0000-0000-0000-000000000001
Authorization: Bearer {{accessToken}}
Accept: application/json

###

POST {{SmartBuilding.Api_HostAddress}}/api/access-points
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
	"floorId": "20000000-0000-0000-0000-000000000001",
	"name": "North Entrance",
	"location": "North Lobby",
	"supportsEntry": true,
	"supportsExit": false
}

###

PUT {{SmartBuilding.Api_HostAddress}}/api/access-points/30000000-0000-0000-0000-000000000001
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
	"floorId": "20000000-0000-0000-0000-000000000001",
	"name": "Main Entrance",
	"location": "Ground Floor Lobby",
	"isActive": true,
	"supportsEntry": true,
	"supportsExit": true
}

###

# Returns 204 because the seeded point has no dependent events, permissions, or alerts.
DELETE {{SmartBuilding.Api_HostAddress}}/api/access-points/30000000-0000-0000-0000-000000000001
Authorization: Bearer {{accessToken}}

###

# Returns 404 because the parent floor does not exist.
POST {{SmartBuilding.Api_HostAddress}}/api/access-points
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
	"floorId": "00000000-0000-0000-0000-000000000099",
	"name": "Unknown Floor Access",
	"location": "Unknown",
	"supportsEntry": true,
	"supportsExit": true
}

###

GET {{SmartBuilding.Api_HostAddress}}/api/users
Authorization: Bearer {{accessToken}}
Accept: application/json

###

# Use an existing user ID. Only an administrator can change roles.
PUT {{SmartBuilding.Api_HostAddress}}/api/users/00000000-0000-0000-0000-000000000001/role
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
	"role": "SecurityOperator"
}

###

POST {{SmartBuilding.Api_HostAddress}}/api/users
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
	"name": "Alex Example",
	"email": "alex@example.com",
	"password": "Example password for local testing"
}

###

GET {{SmartBuilding.Api_HostAddress}}/api/users/00000000-0000-0000-0000-000000000001
Authorization: Bearer {{accessToken}}
Accept: application/json

###

PUT {{SmartBuilding.Api_HostAddress}}/api/users/00000000-0000-0000-0000-000000000001
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
	"name": "Alex Example Updated",
	"email": "alex.updated@example.com",
	"isActive": true
}

###

# Returns 409 while cards, permissions, or occupancy sessions reference the user.
DELETE {{SmartBuilding.Api_HostAddress}}/api/users/00000000-0000-0000-0000-000000000001
Authorization: Bearer {{accessToken}}

###

GET {{SmartBuilding.Api_HostAddress}}/api/cards
Authorization: Bearer {{accessToken}}
Accept: application/json

###

# Create a user first and replace userId with the ID returned by POST /api/users.
POST {{SmartBuilding.Api_HostAddress}}/api/cards
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
	"userId": "00000000-0000-0000-0000-000000000001",
	"cardNumber": "CARD-1001",
	"expiresAt": "2030-12-31T23:59:59Z"
}

###

# Replace the ID below with the ID returned by POST /api/cards.
GET {{SmartBuilding.Api_HostAddress}}/api/cards/00000000-0000-0000-0000-000000000001
Authorization: Bearer {{accessToken}}
Accept: application/json

###

PUT {{SmartBuilding.Api_HostAddress}}/api/cards/00000000-0000-0000-0000-000000000001
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
	"userId": "00000000-0000-0000-0000-000000000001",
	"cardNumber": "CARD-1001-UPDATED",
	"expiresAt": null
}

###

POST {{SmartBuilding.Api_HostAddress}}/api/cards/00000000-0000-0000-0000-000000000001/activate
Authorization: Bearer {{accessToken}}

###

POST {{SmartBuilding.Api_HostAddress}}/api/cards/00000000-0000-0000-0000-000000000001/deactivate
Authorization: Bearer {{accessToken}}

###

GET {{SmartBuilding.Api_HostAddress}}/api/permissions
Authorization: Bearer {{accessToken}}
Accept: application/json

###

# Create the user first; the seeded access point has this ID.
POST {{SmartBuilding.Api_HostAddress}}/api/permissions
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
	"userId": "00000000-0000-0000-0000-000000000001",
	"accessPointId": "30000000-0000-0000-0000-000000000001",
	"validFrom": "2026-10-20T00:00:00Z",
	"validUntil": "2027-10-20T00:00:00Z"
}

###

# Replace the ID below with the ID returned by POST /api/permissions.
GET {{SmartBuilding.Api_HostAddress}}/api/permissions/00000000-0000-0000-0000-000000000001
Authorization: Bearer {{accessToken}}
Accept: application/json

###

PUT {{SmartBuilding.Api_HostAddress}}/api/permissions/00000000-0000-0000-0000-000000000001
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
	"userId": "00000000-0000-0000-0000-000000000001",
	"accessPointId": "30000000-0000-0000-0000-000000000001",
	"validFrom": "2026-10-20T00:00:00Z",
	"validUntil": null,
	"isActive": true
}

###

DELETE {{SmartBuilding.Api_HostAddress}}/api/permissions/00000000-0000-0000-0000-000000000001
Authorization: Bearer {{accessToken}}

###

# Create a user, card, and valid permission first. The seeded access point supports both directions.
POST {{SmartBuilding.Api_HostAddress}}/api/access/requests
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
	"cardNumber": "CARD-1001",
	"accessPointId": "30000000-0000-0000-0000-000000000001",
	"direction": "Entry"
}

###

# Returns the latest access decisions, including granted and denied requests.
GET {{SmartBuilding.Api_HostAddress}}/api/access/events
Authorization: Bearer {{accessToken}}
Accept: application/json

###

# Replace the ID with the event ID returned by POST /api/access/requests.
GET {{SmartBuilding.Api_HostAddress}}/api/access/events/00000000-0000-0000-0000-000000000001
Authorization: Bearer {{accessToken}}
Accept: application/json

###

# Unknown access points cannot be audited because events require a valid access point.
POST {{SmartBuilding.Api_HostAddress}}/api/access/requests
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
	"cardNumber": "CARD-1001",
	"accessPointId": "00000000-0000-0000-0000-000000000099",
	"direction": "Entry"
}

###
